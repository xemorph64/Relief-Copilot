# Copy to .env and fill in. Never commit .env.

# --- Message channel: which WhatsApp backend to use ---
MESSAGE_CHANNEL=twilio     # "twilio" (simpler: sandbox in minutes) or "meta" (Cloud API)

# --- Twilio WhatsApp (console.twilio.com > Messaging > WhatsApp sandbox) ---
TWILIO_ACCOUNT_SID=        # AC.. (Console > Account Info)
TWILIO_AUTH_TOKEN=         # Console > Account Info
TWILIO_WHATSAPP_FROM=      # e.g. whatsapp:+14155238886 (sandbox number)
TWILIO_QR_SID=             # HX.. quick-reply Content template with ids confirm/change/human (see README)
TWILIO_VALIDATE=true       # false only if a tunnelling proxy breaks signature checks

# --- WhatsApp Cloud API (META; only for MESSAGE_CHANNEL=meta) ---
WA_TOKEN=                 # permanent System User access token with whatsapp_business_messaging
WA_PHONE_NUMBER_ID=       # "Phone number ID" (not the phone number itself)
WA_APP_SECRET=            # App settings > Basic > App secret (used to verify webhook signatures)
WA_VERIFY_TOKEN=          # any random string you choose; paste the same value in the webhook config
WA_GRAPH_VERSION=v23.0
WA_FLOW_ID=               # optional: registered review Flow id (dashboard > WhatsApp > Flows); empty = plain buttons
FLOW_ENDPOINT_PASSPHRASE= # optional: Flow data endpoint integrity passphrase

# --- Claude (console.anthropic.com > API keys) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Bhashini ASR/TTS (bhashini.gov.in/ulca > My Profile) ---
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# --- data.gov.in (optional now: LGD village masters, IMD district rainfall) ---
DATA_GOV_IN_API_KEY=

# Public HTTPS base URL of this server (tunnel or deployment), used to hand claim PDFs to WhatsApp
PUBLIC_BASE_URL=
