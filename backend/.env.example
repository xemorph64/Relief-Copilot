# Copy to .env and fill in. Never commit .env.

# --- WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API setup) ---
WA_TOKEN=                 # permanent System User access token with whatsapp_business_messaging
WA_PHONE_NUMBER_ID=       # "Phone number ID" (not the phone number itself)
WA_APP_SECRET=            # App settings > Basic > App secret (used to verify webhook signatures)
WA_VERIFY_TOKEN=          # any random string you choose; paste the same value in the webhook config
WA_GRAPH_VERSION=v23.0

# --- Claude (console.anthropic.com > API keys) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Bhashini ASR/TTS (bhashini.gov.in/ulca > My Profile) ---
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# --- data.gov.in (optional now: LGD village masters, IMD district rainfall) ---
DATA_GOV_IN_API_KEY=

# Public HTTPS base URL of this server (tunnel or deployment), used to hand claim PDFs to WhatsApp
PUBLIC_BASE_URL=
